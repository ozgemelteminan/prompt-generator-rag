# PostgreSQL (used by Docker Compose and the API)
POSTGRES_DB=promptforge
POSTGRES_USER=promptforge
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432

# API
DATABASE_URL=postgresql+psycopg://promptforge:local-development-only@localhost:5432/promptforge
CORS_ORIGINS=http://localhost:3000
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4.1-mini
# Optional; falls back to OPENAI_MODEL when unset.
OPENAI_EXECUTION_MODEL=
OPENAI_TIMEOUT_SECONDS=30
EXECUTION_MAX_INPUT_CHARACTERS=20000

# Single-workspace M2 guardrails (not authentication or billing)
LOCAL_WORKSPACE_ID=local-workspace
RATE_LIMIT_GENERATE_REQUESTS=10
RATE_LIMIT_EXECUTE_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
GENERATION_QUOTA_PER_MONTH=100
EXECUTION_QUOTA_PER_MONTH=200

# Document upload foundation (local filesystem storage only)
DOCUMENT_MAX_UPLOAD_BYTES=10485760
DOCUMENT_STORAGE_PATH=data/uploads
# Structure-aware chunking (local approximate token counts)
CHUNK_TARGET_TOKENS=350
CHUNK_MAX_TOKENS=500
CHUNK_OVERLAP_TOKENS=40

# Production document embeddings (raw passages, normalized vectors)
EMBEDDING_MODEL_ID=intfloat/multilingual-e5-large-instruct
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=
EMBEDDING_MAX_INPUT_TOKENS=

# Dense retrieval (workspace-scoped pgvector cosine search)
RETRIEVAL_DEFAULT_LIMIT=5
RETRIEVAL_MAX_LIMIT=20
HNSW_EF_SEARCH=100

# Deterministic context package for future grounded generation
RAG_CONTEXT_MAX_TOKENS=2000

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
