# Deployment configuration template. Copy to .env and replace every placeholder.
# Values below target Docker Compose; for host-run API use a DATABASE_URL reachable from the host.
APP_ENVIRONMENT=production
DEBUG=false

# PostgreSQL + pgvector
POSTGRES_DB=promptforge
POSTGRES_USER=promptforge
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://promptforge:replace-with-a-strong-password@postgres:5432/promptforge

# Public origins and selected LLM provider. Do not use wildcard CORS origins.
CORS_ORIGINS=https://app.example.com
LLM_PROVIDER=groq
# Set only the key for LLM_PROVIDER. Blank optional values are normalized to unset.
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=
LLM_TIMEOUT_SECONDS=30
EXECUTION_MAX_INPUT_CHARACTERS=20000

# Current single-workspace guardrails (not authentication or billing).
LOCAL_WORKSPACE_ID=local-workspace
RATE_LIMIT_GENERATE_REQUESTS=10
RATE_LIMIT_EXECUTE_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
GENERATION_QUOTA_PER_MONTH=100
EXECUTION_QUOTA_PER_MONTH=200

# Documents: Docker mounts persistent storage at /app/data/uploads.
DOCUMENT_MAX_UPLOAD_BYTES=10485760
DOCUMENT_STORAGE_PATH=/app/data/uploads
CHUNK_TARGET_TOKENS=350
CHUNK_MAX_TOKENS=500
CHUNK_OVERLAP_TOKENS=40

# Production embeddings and bounded dense retrieval.
EMBEDDING_MODEL_ID=intfloat/multilingual-e5-large-instruct
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=
EMBEDDING_MAX_INPUT_TOKENS=
RETRIEVAL_DEFAULT_LIMIT=5
RETRIEVAL_MAX_LIMIT=20
HNSW_EF_SEARCH=100
RAG_CONTEXT_MAX_TOKENS=2000

# Browser-visible API origin; this value is compiled into the web build.
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
API_PORT=8000
WEB_PORT=3000
